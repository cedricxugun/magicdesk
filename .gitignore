# Godot regenerates its import cache from the tracked source and .import settings.
.godot/
.env
.env.*
!.env.example
*.log
*.tmp
*.blend1
*.blend2
__pycache__/
*.py[cod]

# Intermediate renderer and local development host; dist/HELIOS.exe is versioned with LFS.
native/*.exe
native/*.pdb
native/*.pck

# Raw fluid simulation and conversion intermediates. Production R16F .res volumes are tracked.
app/assets/physical_steam/
app/assets/pressure_physics_preview/
app/assets/pressure_physics_96/
app/assets/pressure_physics_burst64/
app/assets/pressure_physics_ground64/
tools/*_prepared/
tools/*.rgba
review/physical_steam/

.DS_Store
Thumbs.db
Desktop.ini

# Per-frame QA images and crop metadata are regenerated; selected reviews live in review/.
tests/**/*.png
tests/**/native_*.json
tests/steam_fix_live/
tests/mechanism_live/
tests/choreography_live/

# Reproducible Mac bundles and local build output.
dist/macos/
dist/macos-review/
dist/staging/
dist/HELIOS-macOS*.zip
dist/HELIOS-macOS*.sha256
dist/MagicDesk-macOS*.zip
dist/MagicDesk-macOS*.sha256

# Superseded local input-debug captures; the verified EXE replay is retained.
review/interaction_native/r1/
review/interaction_native/r2/
review/interaction_native/release/commands.txt
review/interaction_native/release/collection_probe.json
review/interaction_native/final_smoke/commands.txt
review/interaction_native/final_smoke/collection_probe.json

# F authoring take and superseded debug captures are regenerated by the tools.
review/F_complete/physical_take.json
review/F_complete/native/
review/F_complete/release/
review/F_complete/frame_*.png
review/F_complete/equilibrium_peak.png
review/F_complete/final/commands.txt
review/F_complete/final/collection_probe.json
review/F_complete/final/F_native_full.mp4
review/F_complete/live/
review/interaction_native/final_smoke/performance.json

# G regenerated motion samples, unedited raw recording, temporary live commands.
review/G_complete/mechanical_take.json
review/G_complete/frame_*.png
review/G_complete/memory_relief.png
review/G_complete/native/commands.txt
review/G_complete/native/collection_probe.json
review/G_complete/native/G_native_full.mp4
review/G_complete/live/

# Archive rework captures are regenerated; selected evidence remains tracked.
review/G_archive/archive_take.json
review/G_archive/native/commands.txt
review/G_archive/native/collection_probe.json
review/G_archive/native/G_archive_full.mp4
review/G_archive/live/

# Regenerable record-player takes and machine-local preview/input channels.
review/G_record_player/record_take.json
review/G_record_player/blender_control.json
review/G_record_player/blender_ack.json
review/G_record_player/native_console/commands.txt
review/G_record_player/native_console/collection_probe.json
review/G_record_player/native_console/.*.recording-*.mp4
review/G_record_player/live/

# Regenerable, per-frame optical-curator motion data.
review/G_optical_curator/curator_take.json
review/G_optical_curator/live/
review/G_optical_curator/head/head_motion.avi
review/G_optical_curator/service/service_take.json
review/G_optical_curator/operating/curator_take.json
review/G_optical_curator/observatory_r2/app/curator_take.json
# Local pre-edit recovery copies; the current editable source remains tracked.
blender/collection/checkpoints/

# Regenerable fixed-step butterfly review recording.
review/G_optical_curator/butterfly_r2/runtime/*.avi
review/G_optical_curator/butterfly_r2/full_take/curator_take.json

# Local native profiling streams and capture command channels. Selected reports remain tracked.
review/G_optical_curator/butterfly_r2/native/**/frames.csv
review/G_optical_curator/butterfly_r2/native/**/control.json

# Retained local pre-update app bundles.
dist/macos-backups/

# Display review profiling and live commands are local; summaries remain tracked.
review/desktop_scale/native/*frames.csv
review/desktop_scale/native/control.json

review/G_optical_curator/ship_r2/full_take/curator_take.json

# Reproducible recording frames, uncompressed takes and audio-analysis caches.
# Keep authored assets, selected stills, compressed review videos and summaries.
review/**/*.avi
review/**/frames/
review/**/video_frames*/
review/**/png_r*/
review/**/physical_take.json
review/**/curator_take.json
review/**/*.npz

# Archived verification logs are part of the handoff evidence.
!review/**/logs/*.log

# Portable handoff is curated; never bulk-stage historical experiment outputs.
# Current files are explicitly added by tools/prepare_git_handoff.py --stage.
/review/
/blender/collection/*.blend
/app/assets/collection/

# Download bundles and intermediate engraving variants; selected source MIDI/audio
# are tracked explicitly by the portable handoff tool.
/production/I_refinement/moonlight/*.zip
/production/I_refinement/moonlight/engraving/*.midi
